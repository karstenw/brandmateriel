<t tx="karstenw.20230817122000.3">def __init__(self, basecolour=np.array([0, 204, 0, 255]),
             position=np.array([0.0, 0.0, 0.0]),
             yaw=0.0, pitch=0.0, roll=0.0, scale=1.0):
    points = np.array([[1.0, 0.0, -1.0 / np.sqrt(2)],   # 0
                       [-1.0, 0.0, -1.0 / np.sqrt(2)],  # 1
                       [0.0, -1.0, 1.0 / np.sqrt(2)],   # 2
                       [0.0, 1.0, 1.0 / np.sqrt(2)],    # 3
                       ])

    self._patches = np.array([
        [points[1], points[2], points[3]],  # left side
        [points[1], points[0], points[2]],  # back side
        [points[0], points[3], points[2]],  # right side
        [points[0], points[1], points[3]],  # front side
        ])

    self._colours = np.array([[204, 0, 0, 255],
                              [0, 204, 0, 255],
                              [0, 0, 204, 255],
                              [204, 204, 204, 255],
                              ])

    self._orientation = np.array([[1.0, 0.0, 0.0],  # U
                                  [0.0, 1.0, 0.0],  # V
                                  [0.0, 0.0, 1.0]   # W
                                  ])

    self._basecolour = basecolour

    self._position = position

    self._yaw = yaw

    self._pitch = pitch

    self._roll = roll

    self._calc_normals()

    self._calc_positions()

    self._colourise()

    self._scale = scale

    self._exploding = False

    self._exploded = False

</t>
<t tx="karstenw.20230817122000.30">@exploding.setter
def exploding(self, val):
    self._exploding = True if val else False

</t>
<t tx="karstenw.20230817122000.31">@property
def exploded(self):
