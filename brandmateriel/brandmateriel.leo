</t>
<t tx="karstenw.20230817122000.52">def patches(self, indices):
    N = self._patches.shape[1] * indices.size
    return self._patches[indices].reshape((N, 3, 3))

</t>
<t tx="karstenw.20230817122000.53">def patch_positions(self, indices):
    N = self._patch_positions.shape[1] * indices.size
    return self._patch_positions[indices].reshape((N, 3))

</t>
<t tx="karstenw.20230817122000.54">def normals(self, indices):
