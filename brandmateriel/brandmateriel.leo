    self._sealevel = sealevel

    self._flat_sea = flat_sea

    self._make_patches()

    self._calc_positions()

    if self.flat_sea:
        self._flood()

    self._calc_normals()

    self._colourise()

    if not self.flat_sea:
        self._flood()
