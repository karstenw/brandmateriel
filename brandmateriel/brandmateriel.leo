<t tx="karstenw.20230817121942.22">def __init__(self, light_source=LightSource(),
             colour=np.array([1.4142, 1.4142, 1.4142, 1.0]),
             glare=np.array([51, 51, 51, 255]),
             cutoff_distance=None, linear_distance=None):
    self._light_source = light_source

    self._colour = colour

    self._glare = glare

    if cutoff_distance is None:
        self._cutoff_distance = self.light_source.distance
    else:
        self._cutoff_distance = cutoff_distance

    if linear_distance is None:
        self._linear_distance = self.light_source.distance
    else:
        self._linear_distance = linear_distance

