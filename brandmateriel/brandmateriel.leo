<t tx="karstenw.20230817121932.38">def slice(self, position, view):
    the_position = np.round(position).astype(int)

    Y, X = np.mgrid[the_position[self.Y] - view[self.Y] / 2 - 1:
                    the_position[self.Y] + view[self.Y] / 2 + 1,
                    the_position[self.X] - view[self.X] / 2 - 1:
                    the_position[self.X] + view[self.X] / 2 + 1]

    X %= self.shape[self.X]
    Y %= self.shape[self.Y]

    return X, Y

